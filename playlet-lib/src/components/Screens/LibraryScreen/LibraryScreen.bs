import "pkg:/components/ContentNode/ProfileContentAuthTokenUtils.types.bs"
import "pkg:/components/Navigation/Navigation.bs"
import "pkg:/components/Services/LibraryService/LibraryStore.bs"
import "pkg:/source/utils/FocusManagement.bs"
import "pkg:/source/utils/RemoteKeys.bs"

function Init()
    m.rowList = m.top.findNode("rowList")
    m.status = m.top.findNode("status")
    m.top.ObserveField("visible", FuncName(RefreshLibrary))
end function

function OnNodeReady()
    SetNavigation(invalid, RemoteKeys.Back, m.navBar)
    SetNavigation(invalid, RemoteKeys.Left, m.navBar)
    m.rowList@.BindNode()
    m.libraryService.ObserveFieldScoped("changed", FuncName(OnLibraryChanged))
    m.profilesService.ObserveFieldScoped("currentProfileChanged", FuncName(OnLibraryChanged))
    OnLibraryChanged()
end function

function OnLibraryChanged() as void
    m.dirty = true
    RefreshLibrary()
end function

function OnFocusChange() as void
    if m.top.focus
        RefreshLibrary()
        if m.rowList.visible
            NodeSetFocus(m.rowList, true)
        else
            NodeSetFocus(m.navBar, true)
        end if
    end if
end function

function RefreshLibrary() as void
    if not m.top.visible or not m.dirty
        return
    end if
    m.dirty = false
    feeds = []
    data = LibraryStore.Read(LibraryStore.ProfileKey(m.profilesService))
    if data <> invalid
        AddLocalFeed(feeds, Tr(Locale.Library.WatchLater), data.later)
        AddLocalFeed(feeds, Tr(Locale.Library.LikedVideos), data.liked)
        for each playlist in data.playlists
            AddLocalFeed(feeds, playlist.title, playlist.videos)
        end for
        AddLocalFeed(feeds, Tr(Locale.Library.LocalHistory), data.history)
    end if
    profile = m.profilesService.currentProfile
    if profile <> invalid and profile.authState = ProfileContentAuthTokenUtils.ProfileAuthState.Authenticated
        AddAccountFeed(feeds, Tr(Locale.Library.AccountPlaylists), "inv_auth_playlists", "auth_playlists")
        AddAccountFeed(feeds, Tr(Locale.Library.AccountHistory), "inv_auth_history", "watch_history")
    end if
    hasFeeds = feeds.Count() > 0
    m.status.text = Tr(Locale.Library.Empty)
    if data = invalid
        m.status.text = Tr(Locale.Library.ChangeFailed)
    end if
    m.status.visible = not hasFeeds
    m.rowList.visible = hasFeeds
    m.top.focusable = hasFeeds
    m.rowList.feeds = feeds
end function

function AddLocalFeed(feeds as object, title as string, videos as object) as void
    if videos.Count() > 0
        feeds.Push({ title: title, localVideos: videos })
    end if
end function

function AddAccountFeed(feeds as object, title as string, id as string, endpoint as string) as void
    feeds.Push({ title: title, feedSources: [{ id: id, apiType: "Invidious", endpoint: endpoint }] })
end function

function OnKeyEvent(key as string, press as boolean) as boolean
    return NavigationKeyHandler(key, press).handled
end function
