import "pkg:/components/VideoPlayerDev/PlayerCoordinatorLogic.bs"
import "pkg:/components/VideoPlayerDev/TransportController.bs"
import "pkg:/source/utils/Locale.bs"
import "pkg:/source/utils/Types.bs"

' The row sits above the trackbar (y=632) and is centered on screen; BUTTON_WIDTH matches VideoPlayerButton.
const ROW_Y = 556
const BUTTON_WIDTH = 54
const BUTTON_SPACING = 28
const SCREEN_CENTER_X = 640

function Init()
    ' Focus order matches PlayerCoordinatorLogic.PlayerButton.
    m.buttons = [
        m.top.findNode("CaptionsButton")
        m.top.findNode("CommentsButton")
        m.top.findNode("PlayPauseButton")
        m.top.findNode("LikeButton")
        m.top.findNode("MinimizeButton")
    ]
    m.buttonGroup = m.top.findNode("Buttons")
    m.actionHint = m.top.findNode("actionHint")
    LayoutButtons()
    m.top.buttonCount = m.buttons.Count() ' coordinator reads this to clamp focus

    for each field in ["transportMode", "rowFocused", "focusedIndex", "playing", "captionsAvailable", "captionsOn", "liked"]
        m.top.ObserveField(field, FuncName(Repaint))
    end for
    m.top.ObserveField("nudge", FuncName(OnNudge))
    Repaint()
end function

' Forward the nudge to the focused button (an out-of-range focusedIndex indexes to invalid -> no-op).
function OnNudge() as void
    button = m.buttons[m.top.focusedIndex]
    if button <> invalid
        button.nudge = true
    end if
end function

' Position the buttons in a row and center the row on screen, from child count, so adding a button
' auto-positions without hardcoded offsets.
function LayoutButtons() as void
    n = m.buttonGroup.getChildCount()
    for i = 0 to n - 1
        m.buttonGroup.getChild(i).translation = [i * (BUTTON_WIDTH + BUTTON_SPACING), 0]
    end for
    rowWidth = 0
    if n > 0
        rowWidth = n * BUTTON_WIDTH + (n - 1) * BUTTON_SPACING
    end if
    m.buttonGroup.translation = [SCREEN_CENTER_X - rowWidth / 2, ROW_Y]
end function

function Repaint() as void
    ' Hide the row while a transport is active so it's out of the way during seeking. Chrome show/hide
    ' fades the parent group, so visible=true with a hidden parent stays unpainted.
    m.top.visible = (m.top.transportMode = TransportController.Mode.Idle)

    m.buttons[PlayerCoordinatorLogic.PlayerButton.PlayPause].toggleState = not m.top.playing
    m.buttons[PlayerCoordinatorLogic.PlayerButton.Captions].iconColor = "#DDDDDDFF"
    if m.top.captionsOn
        m.buttons[PlayerCoordinatorLogic.PlayerButton.Captions].iconColor = "#3EA6FFFF"
    end if
    m.buttons[PlayerCoordinatorLogic.PlayerButton.Like].iconColor = "#DDDDDDFF"
    if m.top.liked
        m.buttons[PlayerCoordinatorLogic.PlayerButton.Like].iconColor = "#3EA6FFFF"
    end if

    for i = 0 to m.buttons.Count() - 1
        m.buttons[i].focused = m.top.rowFocused and i = m.top.focusedIndex
    end for
    hint = ""
    index = m.top.focusedIndex
    if index = PlayerCoordinatorLogic.PlayerButton.Captions
        hint = Tr(Locale.Library.NoCaptions)
        if m.top.captionsAvailable
            hint = Tr(Locale.Library.CaptionsOn)
            if m.top.captionsOn
                hint = Tr(Locale.Library.CaptionsOff)
            end if
        end if
    else if index = PlayerCoordinatorLogic.PlayerButton.Comments
        hint = Tr(Locale.Library.Comments)
    else if index = PlayerCoordinatorLogic.PlayerButton.Like
        hint = Tr(Locale.Library.Like)
        if m.top.liked
            hint = Tr(Locale.Library.Unlike)
        end if
    end if
    ' center the hint over the focused button
    buttonCenterX = m.buttonGroup.translation[0] + index * (BUTTON_WIDTH + BUTTON_SPACING) + BUTTON_WIDTH / 2
    m.actionHint.translation = [buttonCenterX - m.actionHint.width / 2, ROW_Y - 32]
    m.actionHint.text = hint
    m.actionHint.visible = m.top.rowFocused and hint <> ""
end function
