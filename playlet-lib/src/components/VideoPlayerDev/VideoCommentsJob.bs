import "pkg:/components/Services/Innertube/NextEndpoint.bs"
import "pkg:/components/Services/Invidious/InvidiousService.bs"
import "pkg:/source/utils/Logging.bs"
import "pkg:/source/utils/ObjectUtils.bs"

@job("VideoCommentsJob")
function ExecuteJob() as void
    input = JobGetInput()
    token = ValidString(input.continuation)
    cancellation = JobGetCancellation()
    service = new Invidious.InvidiousService(input.invidious)
    instance = service.GetInstance()
    if instance <> Invidious.PLAYLET_BUILT_IN_INSTANCE
        result = FetchInvidiousComments(instance, input.videoId, token, cancellation)
        ' An Invidious continuation can't be used with Innertube, so only the first page falls back.
        if result.error = invalid and (result.comments.Count() > 0 or token <> "")
            JobSuccessData(result)
            return
        end if
        if token <> ""
            JobError(result.error)
            return
        end if
        LogWarn("Invidious comments unavailable, falling back to Innertube:", result.error)
        if JobIsCancelled()
            return
        end if
    end if

    result = FetchInnertubeComments(input.videoId, token, ValidString(input.visitorData), cancellation)
    if result.error <> invalid
        JobError(result.error)
        return
    end if
    JobSuccessData(result)
end function

function FetchInvidiousComments(instance as string, videoId as string, token as string, cancellation as dynamic) as object
    request = HttpClient.Get(`${instance}/api/v1/comments/${videoId}`).Cancellation(cancellation)
    if token <> ""
        request.QueryParam("continuation", token)
    end if
    response = request.Await()
    if not response.IsSuccess()
        return { error: response.ErrorMessage() }
    end if
    payload = response.Json()
    if not IsAssociativeArray(payload) or not IsArray(payload.comments)
        return { error: "Invalid comments response" }
    end if
    comments = []
    for each comment in payload.comments
        AddComment(comments, comment.author, comment.content)
    end for
    return { comments: comments, continuation: ValidString(payload.continuation) }
end function

function FetchInnertubeComments(videoId as string, token as string, visitorData as string, cancellation as dynamic) as object
    tokens = [token]
    if token = ""
        ' Keys are quoted: Roku lowercases unquoted AA literal keys, and YouTube ignores "videoid".
        response = Innertube.CreateNextRequest({ "videoId": videoId }, NextOptions(visitorData)).Cancellation(cancellation).Await()
        if not response.IsSuccess()
            return { error: response.ErrorMessage() }
        end if
        payload = response.Json()
        if not IsAssociativeArray(payload)
            return { error: "Invalid next response" }
        end if
        if visitorData = ""
            visitorData = ValidString(ObjectUtils.Dig(payload, ["responseContext", "visitorData"]))
        end if
        tokens = []
        FindCommentEntries(payload, tokens)
        LogInfo("Comment continuation candidates for", videoId, ":", tokens.Count())
    end if

    ' Comments disabled (or no section in the response) is an empty result, not an error.
    result = { comments: [], continuation: "" }
    lastError = invalid
    for each candidate in tokens
        if JobIsCancelled()
            return result
        end if
        response = Innertube.CreateNextRequest({ "continuation": candidate }, NextOptions(visitorData)).Cancellation(cancellation).Await()
        if not response.IsSuccess()
            lastError = response.ErrorMessage()
            continue for
        end if
        payload = response.Json()
        if not IsAssociativeArray(payload)
            lastError = "Invalid comments response"
            continue for
        end if
        result = ParseYouTubeComments(payload)
        LogInfo("Parsed", result.comments.Count(), "comments for", videoId)
        if result.comments.Count() > 0
            return result
        end if
    end for
    if result.comments.Count() = 0 and lastError <> invalid
        return { error: lastError }
    end if
    return result
end function

function NextOptions(visitorData as string) as dynamic
    if visitorData = ""
        return invalid
    end if
    return { "visitorData": visitorData }
end function

' Collects every comments continuation token (the comments item section and the comments engagement panel),
' in document order and de-duplicated, so a stale or empty one doesn't hide the others.
function FindCommentEntries(value as dynamic, tokens as object) as void
    if IsAssociativeArray(value)
        section = value.itemSectionRenderer
        if section <> invalid and (section.targetId = "comments-section" or section.sectionIdentifier = "comment-item-section")
            for each item in ValidArray(section.contents)
                AddToken(tokens, CommentContinuation(item))
            end for
        end if
        panel = value.engagementPanelSectionListRenderer
        if panel <> invalid and panel.targetId = "engagement-panel-comments-section"
            AddToken(tokens, ValidString(ObjectUtils.Dig(panel, ["content", "sectionListRenderer", "contents", 0, "continuationItemRenderer", "continuationEndpoint", "continuationCommand", "token"])))
        end if
        for each key in value
            FindCommentEntries(value[key], tokens)
        end for
    else if IsArray(value)
        for each entry in value
            FindCommentEntries(entry, tokens)
        end for
    end if
end function

function AddToken(tokens as object, token as string) as void
    if token = ""
        return
    end if
    for each existing in tokens
        if existing = token
            return
        end if
    end for
    tokens.Push(token)
end function
function CommentContinuation(item as object) as string
    return ValidString(ObjectUtils.Dig(item, ["continuationItemRenderer", "continuationEndpoint", "continuationCommand", "token"]))
end function

function ParseYouTubeComments(payload as object) as object
    comments = []
    entities = {}
    mutations = ValidArray(ObjectUtils.Dig(payload, ["frameworkUpdates", "entityBatchUpdate", "mutations"]))
    for each mutation in mutations
        entity = ObjectUtils.Dig(mutation, ["payload", "commentEntityPayload"])
        if entity <> invalid and ValidString(entity.key) <> ""
            entities[entity.key] = entity
        end if
    end for
    commands = ValidArray(ObjectUtils.Dig(payload, ["onResponseReceivedEndpoints"]))
    continuation = ""
    for each command in commands
        action = command.appendContinuationItemsAction
        if action = invalid
            action = command.reloadContinuationItemsCommand
        end if
        if action = invalid
            continue for
        end if
        for each item in ValidArray(action.continuationItems)
            thread = item.commentThreadRenderer
            if thread <> invalid
                key = ValidString(ObjectUtils.Dig(thread, ["commentViewModel", "commentViewModel", "commentKey"]))
                entity = entities[key]
                if entity <> invalid
                    AddComment(comments, ObjectUtils.Dig(entity, ["author", "displayName"]), ObjectUtils.Dig(entity, ["properties", "content", "content"]))
                else
                    legacy = ObjectUtils.Dig(thread, ["comment", "commentRenderer"])
                    if legacy <> invalid
                        AddComment(comments, Innertube.ParseText(legacy.authorText), Innertube.ParseText(legacy.contentText))
                    end if
                end if
            end if
            token = CommentContinuation(item)
            if token <> "" and (action.targetId = "comments-section" or action.targetId = "engagement-panel-comments-section")
                continuation = token
            end if
        end for
    end for
    return { comments: comments, continuation: continuation }
end function

function AddComment(comments as object, author as dynamic, text as dynamic) as void
    if ValidString(text) <> ""
        comments.Push({ author: Left(ValidString(author), 120), text: Left(text, 900) })
    end if
end function
