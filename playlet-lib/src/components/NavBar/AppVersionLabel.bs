import "pkg:/components/Services/ApplicationInfo/LibManifestUtils.bs"

const LIB_CANARY_URL_PATTERN = "^https://github\.com/Kovee98/(?:playlet|bluetube)/releases/download/canary/playlet-lib\.(?:zip|squashfs\.pkg)$"

function Init()
    m.top.text = GetAppVersion()
end function

' TODO:P2: refactor and move to appropriate place, reuse with web app
function GetAppVersion() as string
    version = "v" + LibManifestUtils.GetLibVersion()

    roAppInfo = CreateObject("roAppInfo")
    appId = roAppInfo.GetID()
    if appId = "dev"
        version += "-dev"
    end if

    scene = m.top.getScene()
    if scene.playletLibLoadedUrl <> invalid
        libUrl = scene.playletLibLoadedUrl.link
        libUrlType = scene.playletLibLoadedUrl.type

        if libUrlType = "custom" and CreateObject("roRegex", LIB_CANARY_URL_PATTERN, "i").IsMatch(libUrl)
            version += "-canary"
        end if
    end if

    return version
end function
